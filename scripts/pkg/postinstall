#!/bin/sh
# MacPad++ package postinstall (runs as root after the app is copied) — MAC-28.
# Installs MacPad++'s privileged helper as a launchd daemon, so administrator saves can use Touch ID
# without any further approval step: the user already approved this installation.
# Never fails the installation: without the helper, MacPad++ falls back to the password prompt.
# Test overrides (never set by Installer): MACPAD_LAUNCHD_DIR, MACPAD_LAUNCHCTL, MACPAD_BIN_DIR,
# MACPAD_SECURITY, MACPAD_HELPER_TOOLS_DIR.
set -u

LABEL="app.macpad.MacPad.helper"
TARGET="${2:-/Applications}"                       # the package's install location
HELPER="$TARGET/MacPad++.app/Contents/MacOS/MacPadHelper"
DAEMONS="${MACPAD_LAUNCHD_DIR:-/Library/LaunchDaemons}"
LAUNCHCTL="${MACPAD_LAUNCHCTL:-/bin/launchctl}"
PLIST="$DAEMONS/$LABEL.plist"
# MAC-56: launchd runs a root-owned copy of the helper, outside /Applications (which admin-group
# processes can write: replacing the bundle must not replace what runs as root).
TOOLS="${MACPAD_HELPER_TOOLS_DIR:-/Library/PrivilegedHelperTools}"
INSTALLED="$TOOLS/$LABEL"

# MAC-52: the `macpad` command-line tool on the PATH, as a link into the app. A `macpad` there that
# is not MacPad++'s own link is left alone.
BIN="${MACPAD_BIN_DIR:-/usr/local/bin}"
TOOL="$TARGET/MacPad++.app/Contents/MacOS/macpad"
if [ -x "$TOOL" ]; then
  mkdir -p "$BIN"
  if [ ! -e "$BIN/macpad" ] && [ ! -L "$BIN/macpad" ]; then
    ln -s "$TOOL" "$BIN/macpad"
  elif [ -L "$BIN/macpad" ] && readlink "$BIN/macpad" | grep -q 'MacPad++\.app/Contents/MacOS/macpad$'; then
    ln -sfn "$TOOL" "$BIN/macpad"
  else
    echo "MacPad++: $BIN/macpad is not MacPad++'s; left as it is" >&2
  fi
fi

# MAC-55: the authorization right the helper asks for on every save — an administrator, every
# time (not shared with other rights, never cached). Without it the helper refuses to write.
SECURITY="${MACPAD_SECURITY:-/usr/bin/security}"
"$SECURITY" authorizationdb write app.macpad.MacPad.save >/dev/null 2>&1 <<'RIGHT_END' || echo "MacPad++: could not install the save right; administrator saves will use the password prompt" >&2
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>class</key>
	<string>user</string>
	<key>group</key>
	<string>admin</string>
	<key>authenticate-user</key>
	<true/>
	<key>shared</key>
	<false/>
	<key>timeout</key>
	<integer>0</integer>
	<key>allow-root</key>
	<false/>
	<key>session-owner</key>
	<false/>
	<key>version</key>
	<integer>1</integer>
	<key>comment</key>
	<string>MacPad++: save one file as administrator.</string>
</dict>
</plist>
RIGHT_END

if [ ! -x "$HELPER" ]; then
  echo "MacPad++: helper not found at $HELPER; administrator saves will use the password prompt" >&2
  exit 0
fi

# Replace a running helper (from a previous version) cleanly.
"$LAUNCHCTL" bootout "system/$LABEL" >/dev/null 2>&1 || true

mkdir -p "$TOOLS"
COPY="$INSTALLED.macpad-tmp.$$"
/bin/rm -f "$COPY"
if ! /bin/cp "$HELPER" "$COPY"; then
  /bin/rm -f "$COPY"
  echo "MacPad++: could not install the helper in $TOOLS; administrator saves will use the password prompt" >&2
  exit 0
fi
/bin/chmod 544 "$COPY"
if [ "$(id -u)" = "0" ]; then /usr/sbin/chown root:wheel "$COPY"; fi
/bin/mv -f "$COPY" "$INSTALLED"

# XML-escape the path for the plist (the folder could in principle contain & < >).
ESCAPED=$(printf '%s' "$INSTALLED" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g')

mkdir -p "$DAEMONS"
TMP="$PLIST.macpad-tmp.$$"
cat > "$TMP" <<PLIST_END
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>$LABEL</string>
	<key>Program</key>
	<string>$ESCAPED</string>
	<key>MachServices</key>
	<dict>
		<key>$LABEL</key>
		<true/>
	</dict>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>app.macpad.MacPad</string>
	</array>
	<key>SpawnConstraint</key>
	<dict>
		<key>team-identifier</key>
		<string>96Y4LX7FVB</string>
		<key>signing-identifier</key>
		<string>$LABEL</string>
	</dict>
</dict>
</plist>
PLIST_END
chmod 644 "$TMP"
if [ "$(id -u)" = "0" ]; then chown root:wheel "$TMP"; fi
mv -f "$TMP" "$PLIST"

if ! "$LAUNCHCTL" bootstrap system "$PLIST"; then
  echo "MacPad++: could not start the helper; administrator saves will use the password prompt" >&2
fi
exit 0
