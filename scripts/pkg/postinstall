#!/bin/sh
# Inkpad++ package postinstall (runs as root after the app is copied) — MAC-28.
# Installs Inkpad++'s privileged helper as a launchd daemon, so administrator saves can use Touch ID
# without any further approval step: the user already approved this installation.
# Never fails the installation: without the helper, Inkpad++ falls back to the password prompt.
# Test overrides (never set by Installer): INKPAD_LAUNCHD_DIR, INKPAD_LAUNCHCTL, INKPAD_BIN_DIR,
# INKPAD_SECURITY, INKPAD_HELPER_TOOLS_DIR.
set -u
# MAC-58: the test overrides below are honoured only when not running as root, so nothing in the
# environment can choose what root runs or touches.
if [ "$(/usr/bin/id -u)" = "0" ]; then
  unset INKPAD_LAUNCHD_DIR INKPAD_LAUNCHCTL INKPAD_BIN_DIR INKPAD_SECURITY INKPAD_HELPER_TOOLS_DIR INKPAD_PKGUTIL
fi

LABEL="app.inkpad.Inkpad.helper"
TARGET="${2:-/Applications}"                       # the package's install location
HELPER="$TARGET/Inkpad++.app/Contents/MacOS/InkpadHelper"
DAEMONS="${INKPAD_LAUNCHD_DIR:-/Library/LaunchDaemons}"
LAUNCHCTL="${INKPAD_LAUNCHCTL:-/bin/launchctl}"
PLIST="$DAEMONS/$LABEL.plist"
# MAC-56: launchd runs a root-owned copy of the helper, outside /Applications (which admin-group
# processes can write: replacing the bundle must not replace what runs as root).
TOOLS="${INKPAD_HELPER_TOOLS_DIR:-/Library/PrivilegedHelperTools}"
INSTALLED="$TOOLS/$LABEL"

# MAC-52: the `inkpad` command-line tool on the PATH, as a link into the app. A `inkpad` there that
# is not Inkpad++'s own link is left alone.
BIN="${INKPAD_BIN_DIR:-/usr/local/bin}"
TOOL="$TARGET/Inkpad++.app/Contents/MacOS/inkpad"
if [ -x "$TOOL" ]; then
  mkdir -p "$BIN"
  if [ ! -e "$BIN/inkpad" ] && [ ! -L "$BIN/inkpad" ]; then
    ln -sfn "$TOOL" "$BIN/inkpad"
  elif [ -L "$BIN/inkpad" ] && readlink "$BIN/inkpad" | grep -q 'Inkpad++\.app/Contents/MacOS/inkpad$'; then
    ln -sfn "$TOOL" "$BIN/inkpad"
  else
    echo "Inkpad++: $BIN/inkpad is not Inkpad++'s; left as it is" >&2
  fi
fi

# --- Legacy cleanup (MAC-78) -------------------------------------------------------------------
# Inkpad++ was called MacPad++ up to 1.1.3. Remove that install: its helper daemon and root copy,
# its save right, its `macpad` link (only Inkpad++'s own), its receipt, and the old app — only if
# the bundle really is the old one. Delete this block once no MacPad++ installs are left.
LEGACY_LABEL="app.macpad.MacPad.helper"
"${INKPAD_LAUNCHCTL:-/bin/launchctl}" bootout "system/$LEGACY_LABEL" >/dev/null 2>&1 || true
/bin/rm -f "${INKPAD_LAUNCHD_DIR:-/Library/LaunchDaemons}/$LEGACY_LABEL.plist" \
  "${INKPAD_HELPER_TOOLS_DIR:-/Library/PrivilegedHelperTools}/$LEGACY_LABEL"
"${INKPAD_SECURITY:-/usr/bin/security}" authorizationdb remove app.macpad.MacPad.save </dev/null >/dev/null 2>&1 || true
if [ -L "$BIN/macpad" ] && readlink "$BIN/macpad" | grep -q 'MacPad++\.app/Contents/MacOS/macpad$'; then
  /bin/rm -f "$BIN/macpad"
fi
"${INKPAD_PKGUTIL:-/usr/sbin/pkgutil}" --forget app.macpad.MacPad >/dev/null 2>&1 || true
LEGACY_APP="$TARGET/MacPad++.app"
if [ -d "$LEGACY_APP" ] && [ ! -L "$LEGACY_APP" ] &&
   [ "$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$LEGACY_APP/Contents/Info.plist" 2>/dev/null)" = "app.macpad.MacPad" ]; then
  /bin/rm -rf "$LEGACY_APP"
fi
# --- End of legacy cleanup ---------------------------------------------------------------------

# MAC-55: the authorization right the helper asks for on every save — an administrator, every
# time (not shared with other rights, never cached). Without it the helper refuses to write.
SECURITY="${INKPAD_SECURITY:-/usr/bin/security}"
"$SECURITY" authorizationdb write app.inkpad.Inkpad.save >/dev/null 2>&1 <<'RIGHT_END' || echo "Inkpad++: could not install the save right; administrator saves will use the password prompt" >&2
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>class</key>
	<string>user</string>
	<key>group</key>
	<string>admin</string>
	<key>authenticate-user</key>
	<true/>
	<key>shared</key>
	<false/>
	<key>timeout</key>
	<integer>0</integer>
	<key>allow-root</key>
	<false/>
	<key>session-owner</key>
	<false/>
	<key>version</key>
	<integer>1</integer>
	<key>comment</key>
	<string>Inkpad++: save one file as administrator.</string>
</dict>
</plist>
RIGHT_END

if [ ! -x "$HELPER" ]; then
  echo "Inkpad++: helper not found at $HELPER; administrator saves will use the password prompt" >&2
  exit 0
fi

# Replace a running helper (from a previous version) cleanly.
"$LAUNCHCTL" bootout "system/$LABEL" >/dev/null 2>&1 || true

mkdir -p "$TOOLS"
COPY="$INSTALLED.inkpad-tmp.$$"
/bin/rm -f "$COPY"
if ! /bin/cp "$HELPER" "$COPY"; then
  /bin/rm -f "$COPY"
  echo "Inkpad++: could not install the helper in $TOOLS; administrator saves will use the password prompt" >&2
  exit 0
fi
/bin/chmod 544 "$COPY"
if [ "$(id -u)" = "0" ]; then /usr/sbin/chown root:wheel "$COPY"; fi
/bin/mv -f "$COPY" "$INSTALLED"

# XML-escape the path for the plist (the folder could in principle contain & < >).
ESCAPED=$(printf '%s' "$INSTALLED" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g')

mkdir -p "$DAEMONS"
TMP="$PLIST.inkpad-tmp.$$"
cat > "$TMP" <<PLIST_END
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>$LABEL</string>
	<key>Program</key>
	<string>$ESCAPED</string>
	<key>MachServices</key>
	<dict>
		<key>$LABEL</key>
		<true/>
	</dict>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>app.inkpad.Inkpad</string>
	</array>
	<key>SpawnConstraint</key>
	<dict>
		<key>team-identifier</key>
		<string>96Y4LX7FVB</string>
		<key>signing-identifier</key>
		<string>$LABEL</string>
	</dict>
</dict>
</plist>
PLIST_END
chmod 644 "$TMP"
if [ "$(id -u)" = "0" ]; then chown root:wheel "$TMP"; fi
mv -f "$TMP" "$PLIST"

if ! "$LAUNCHCTL" bootstrap system "$PLIST"; then
  echo "Inkpad++: could not start the helper; administrator saves will use the password prompt" >&2
fi
exit 0
